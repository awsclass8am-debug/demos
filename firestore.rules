rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ======================================================
    // HELPER FUNCTIONS
    // ======================================================
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in ['admin@helpalot.help'];
    }

    // ======================================================
    // STUDENTS
    // A student can create their own doc and read/update it.
    // Admin can read/write all students.
    // ======================================================
    match /students/{studentId} {
      allow create: if isOwner(studentId);
      allow read:   if isOwner(studentId) || isAdmin();
      allow update: if isSignedIn(); // admin updates status; student updates profile
    }

    // ======================================================
    // TASKS / ASSIGNMENTS
    // Any signed-in approved student can read.
    // Only admin/trainer can write.
    // ======================================================
    match /tasks/{taskId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn(); // Tighten in production with custom claims
    }

    // ======================================================
    // LEARNING CONTENT
    // ======================================================
    match /content/{contentId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn();
    }

    // ======================================================
    // MEETINGS / CLASSES
    // ======================================================
    match /meetings/{meetingId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn();
    }

    // ======================================================
    // SUBMISSIONS
    // A student can only create submissions tied to their UID.
    // Anyone signed in can read (for trainer review).
    // ======================================================
    match /submissions/{subId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read:   if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ======================================================
    // ANNOUNCEMENTS
    // All signed-in users read. Trainers/Admin write.
    // ======================================================
    match /announcements/{annId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn();
    }

    // ======================================================
    // CERTIFICATES
    // Public read (for QR verification link).
    // Only admin can write/issue.
    // ======================================================
    match /certificates/{certId} {
      allow read:  if true; // Public — so the certificate URL works without login
      allow write: if isAdmin();
    }

    // ======================================================
    // COURSES / PROGRAMS
    // ======================================================
    match /courses/{courseId} {
      allow read:  if true; // Public listing
      allow write: if isSignedIn();
    }

    // ======================================================
    // TRAINERS
    // ======================================================
    match /trainers/{trainerId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ======================================================
    // ATTENDANCE
    // Trainers mark, students read their own.
    // ======================================================
    match /attendance/{attId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn();
    }

    // ======================================================
    // SUPPORT TICKETS
    // Students create and read their own.
    // Admin reads all.
    // ======================================================
    match /tickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read:   if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin(); // to mark resolved
    }

  }
}
